# Groq API Key (required) - get from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# TypeSafe Jev API Key (required) - get from https://app.typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional: Override default Groq model per tier
# GROQ_MODEL_LOW=llama-3.1-8b-instant
# GROQ_MODEL_MEDIUM=openai/gpt-oss-20b
# GROQ_MODEL_HIGH=llama-3.3-70b-versatile
# GROQ_MODEL_TOP=openai/gpt-oss-120b
